DATABASE_URL=postgres://postgres:12345@localhost:5432/research_agent
SECRET_KEY=django-insecure-development-key
DEBUG=true
CELERY_BROKER_URL=redis://localhost:6379/0
REPO_SYNC_TTL_HOURS=3

# LLM_PROVIDER: gemini | ollama
LLM_PROVIDER=gemini
# LLM_MODEL: gemini-2.5-flash-lite | qwen2.5:7b
LLM_MODEL=gemini-2.5-flash-lite

# Required when LLM_PROVIDER=gemini; obtain from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# When true, GeminiProvider sleeps on 429 (Gemini's suggested retryDelay) and retries up to MAX_RETRIES
ENABLE_GEMINI_RETRY_BACKOFF=true
